{
  "modality": "spatial",
  "name": "空间转录组分析流程",
  "nodes": [
    {"id": "import", "label": "数据导入", "type": "import", "params": [{"key": "file", "label": "Visium/Stere-seq数据", "type": "file_select", "required": true}]},
    {"id": "qc", "label": "QC 质控", "type": "analysis", "depends_on": ["import"], "params": [
      {"key": "min_genes", "label": "最低基因数", "type": "integer", "default": 200},
      {"key": "min_counts", "label": "最低UMI数", "type": "integer", "default": 500}
    ]},
    {"id": "normalize", "label": "标准化", "type": "analysis", "depends_on": ["qc"], "params": [
      {"key": "target_sum", "label": "标准化目标值", "type": "integer", "default": 10000}
    ]},
    {"id": "hvg", "label": "高变基因", "type": "analysis", "depends_on": ["normalize"], "params": [
      {"key": "n_top_genes", "label": "高变基因数", "type": "integer", "default": 2000}
    ]},
    {"id": "reduce", "label": "降维", "type": "analysis", "depends_on": ["hvg"], "params": [
      {"key": "n_pcs", "label": "主成分数", "type": "integer", "default": 50}
    ]},
    {"id": "cluster", "label": "空间聚类", "type": "analysis", "depends_on": ["reduce"], "params": [
      {"key": "resolution", "label": "分辨率", "type": "number", "default": 0.8, "min": 0.1, "max": 2.0, "step": 0.1}
    ]},
    {"id": "spatial_de", "label": "空间差异表达", "type": "analysis", "depends_on": ["cluster"], "params": [
      {"key": "method", "label": "方法", "type": "select", "options": ["spark_x", "trendsceek", "spatialde"], "default": "spark_x"}
    ]},
    {"id": "niche", "label": "微环境分析", "type": "branch_optional", "depends_on": ["cluster"], "params": [
      {"key": "method", "label": "方法", "type": "select", "options": ["cell2location", "rctd", "stereoscope"], "default": "cell2location"}
    ]},
    {"id": "visualize", "label": "可视化", "type": "branch_optional", "depends_on": ["cluster", "spatial_de"], "params": [
      {"key": "type", "label": "图表类型", "type": "select", "options": ["spatial_umap", "spatial_heatmap", "spatial_scatter"], "default": "spatial_umap"}
    ]}
  ],
  "edges": [
    {"source": "import", "target": "qc"}, {"source": "qc", "target": "normalize"},
    {"source": "normalize", "target": "hvg"}, {"source": "hvg", "target": "reduce"},
    {"source": "reduce", "target": "cluster"}, {"source": "cluster", "target": "spatial_de"},
    {"source": "cluster", "target": "niche"}, {"source": "cluster", "target": "visualize"},
    {"source": "spatial_de", "target": "visualize"}
  ]
}
